<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    tools:context=".LearnActivity">

    <com.danjonesapps.vocabr.DiagonalBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/text_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="@font/cascadia_mono"
        android:textColor="@color/term_white"
        app:layout_constraintVertical_bias="0.01"
        app:layout_constraintHorizontal_bias="0.06"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Smaller Text Below and Slightly to the Right -->
    <TextView
        android:id="@+id/subText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logo_sub_text"
        android:textSize="10sp"
        android:fontFamily="@font/cascadia_mono"
        android:textColor="@color/term_white"
        app:layout_constraintHorizontal_bias="0.06"
        app:layout_constraintTop_toBottomOf="@id/text_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/text_logo"
        android:translationY="12dp"
        android:translationX="20dp"
        tools:ignore="SmallSp" />

    <TextView
        android:id="@+id/text_quitting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cascadia_mono"
        android:text="@string/quitting_text"
        android:textColor="@color/term_white"
        android:textSize="18sp"
        android:visibility="invisible"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.174"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_correct"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/counter_background_right"
        android:backgroundTint="@color/card_gray"
        android:fontFamily="@font/cascadia_mono"
        android:gravity="center_vertical|end"
        android:minWidth="70dp"
        android:paddingEnd="25dp"
        android:paddingStart="10dp"
        android:text="@string/count_text_default"
        android:textStyle="bold"
        android:textColor="@color/correct_green"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.17" />

    <TextView
        android:id="@+id/text_incorrect"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/counter_background_left"
        android:backgroundTint="@color/card_gray"
        android:fontFamily="@font/cascadia_mono"
        android:gravity="center_vertical|start"
        android:minWidth="70dp"
        android:paddingStart="25dp"
        android:paddingEnd="10dp"
        android:text="@string/count_text_default"
        android:textStyle="bold"
        android:textColor="@color/incorrect_red"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.17" />

    <androidx.cardview.widget.CardView
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="16dp"
        android:layout_margin="16dp"
        app:cardElevation="0dp"
        android:backgroundTint="@color/card_gray"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintVertical_bias="0.552"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/text_term"
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:fontFamily="@font/cascadia_mono"
                android:text="@string/term_text_default"
                android:textColor="@color/term_white"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintWidth_percent="0.9"
                app:layout_constraintHeight_percent="0.8"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                android:layout_width="70dp"
                android:layout_height="50dp"
                app:icon="@drawable/redo_icon"
                app:iconTint="@color/term_white"
                app:iconSize="24dp"
                android:contentDescription="@string/back_button_content_description"
                app:iconGravity="textStart"
                android:paddingStart="34dp"
                android:paddingEnd="28dp"
                android:backgroundTint="@color/card_gray"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/text_learnt_score"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_learnt_score"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cascadia_mono"
                android:text="@string/learnt_score_default_text"
                android:textColor="@color/term_white"
                android:textSize="18sp"
                android:gravity="center"
                android:paddingEnd="28dp"
                android:layout_marginTop="11dp"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintHorizontal_bias="0.61"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/button_back"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_term_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cascadia_mono"
                android:text="@string/term_type_default_text"
                android:textColor="@color/term_white"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="11dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/button_quit"
        android:layout_width="60dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/button_gray"
        android:fontFamily="@font/cascadia_mono"
        android:padding="0dp"
        android:text="@string/quit_button_text"
        android:textColor="@color/term_white"
        android:textStyle="bold"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.014"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/button_save"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/button_gray"
        android:fontFamily="@font/cascadia_mono"
        android:padding="0dp"
        android:text="@string/save_button_text"
        android:textStyle="bold"
        android:textColor="@color/term_white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.71"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.014"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/button_correct"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:fontFamily="@font/cascadia_mono"
        android:textStyle="bold"
        android:backgroundTint="@color/correct_green"
        android:text="@string/correct_button_text"
        android:textColor="@color/term_white"
        android:textSize="25sp"
        android:padding="0dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintVertical_bias="0.92"
        app:layout_constraintStart_toEndOf="@id/button_show"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_incorrect"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:fontFamily="@font/cascadia_mono"
        android:textStyle="bold"
        android:backgroundTint="@color/incorrect_red"
        android:text="@string/incorrect_button_text"
        android:textColor="@color/term_white"
        android:textSize="24sp"
        android:padding="0dp"
        android:layout_marginStart="15dp"
        app:layout_constraintVertical_bias="0.92"
        app:layout_constraintEnd_toStartOf="@id/button_show"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_show"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:fontFamily="@font/cascadia_mono"
        android:backgroundTint="@color/quitting_yellow"
        android:padding="0dp"
        android:text="@string/show_button_text"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="24sp"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintVertical_bias="0.92"
        app:layout_constraintStart_toEndOf="@id/button_incorrect"
        app:layout_constraintEnd_toStartOf="@id/button_correct"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/search_bar"
        layout="@layout/custom_search_view"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@drawable/search_background"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.09"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.danjonesapps.vocabr.CustomRecyclerView
        android:id="@+id/term_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="3dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:elevation="2dp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>