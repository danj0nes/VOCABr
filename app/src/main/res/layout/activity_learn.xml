<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    tools:context=".LearnActivity">

    <com.danjonesapps.vocabr.DiagonalBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/text_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="25dp"
        android:textStyle="bold"
        android:fontFamily="@font/cascadia_mono"
        android:textColor="@color/term_white"
        app:layout_constraintVertical_bias="0.01"
        app:layout_constraintHorizontal_bias="0.06"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Smaller Text Below and Slightly to the Right -->
    <TextView
        android:id="@+id/subText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logo_sub_text"
        android:textSize="10dp"
        android:fontFamily="@font/cascadia_mono"
        android:textColor="@color/term_white"
        app:layout_constraintHorizontal_bias="0.06"
        app:layout_constraintTop_toBottomOf="@id/text_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/text_logo"
        android:translationY="12dp"
        android:translationX="20dp"
        tools:ignore="SmallSp" />

    <TextView
        android:id="@+id/text_quitting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cascadia_mono"
        android:text="@string/quitting_text"
        android:textColor="@color/term_white"
        android:textSize="18dp"
        android:visibility="invisible"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.174"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_correct"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/counter_background_right"
        android:backgroundTint="@color/card_gray"
        android:fontFamily="@font/cascadia_mono"
        android:gravity="center_vertical|end"
        android:minWidth="70dp"
        android:paddingEnd="25dp"
        android:paddingStart="10dp"
        android:text="@string/count_text_default"
        android:textStyle="bold"
        android:textColor="@color/correct_green"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.17" />

    <TextView
        android:id="@+id/text_incorrect"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/counter_background_left"
        android:backgroundTint="@color/card_gray"
        android:fontFamily="@font/cascadia_mono"
        android:gravity="center_vertical|start"
        android:minWidth="70dp"
        android:paddingStart="25dp"
        android:paddingEnd="10dp"
        android:text="@string/count_text_default"
        android:textStyle="bold"
        android:textColor="@color/incorrect_red"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.17" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/term_card"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:backgroundTint="#2C2E30"
        app:rippleColor="#08FFFFFF"
        app:layout_constraintWidth_percent="0.87"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintVertical_bias="0.583"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/header_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="@color/card_gray"
                app:shapeAppearanceOverlay="@style/TopRoundedCard"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/examples"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_term_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/term_type_default_text"
                        android:textColor="@color/term_white_def"
                        android:fontFamily="@font/cascadia_mono"
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="3dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="30dp"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:id="@+id/text_term"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/term_text_default"
                            android:textColor="@color/term_white"
                            android:fontFamily="@font/cascadia_mono"
                            android:textStyle="bold"
                            android:textSize="23dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/text_sub_term"/>

                        <TextView
                            android:id="@+id/text_sub_term"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/definition_text_default"
                            android:textColor="@color/term_white_def"
                            android:fontFamily="@font/cascadia_mono"
                            android:textStyle="bold"
                            android:textSize="15dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/text_term"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/examples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/header_card"
                app:layout_constraintBottom_toBottomOf="parent">
                <TextView
                    android:id="@+id/examples_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="no examples found"
                    android:textColor="@color/example_definition"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/example_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="je n'en reviens pas"
                    android:textColor="@color/term_white_def"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/example_1_def"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I can't believe it"
                    android:textColor="@color/example_definition"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/example_1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/example_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Je ne mangerai pas aujourd'hui"
                    android:textColor="@color/term_white_def"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:layout_marginTop="9dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/example_1_def"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/example_2_def"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I will not eat today"
                    android:textColor="@color/example_definition"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/example_2"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/example_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Je vais aller au travail demain"
                    android:textColor="@color/term_white_def"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="17dp"
                    android:textStyle="bold"
                    android:layout_marginTop="9dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/example_2_def"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/example_3_def"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I'm going to go to work tomorrow"
                    android:textColor="@color/example_definition"
                    android:fontFamily="@font/cascadia_mono"
                    android:textSize="13dp"
                    android:visibility="gone"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp"
                    app:layout_constraintTop_toBottomOf="@id/example_3"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/button_quit"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/button_gray"
        android:fontFamily="@font/cascadia_mono"
        android:padding="0dp"
        android:text="@string/quit_button_text"
        android:textColor="@color/term_white"
        android:textStyle="bold"
        android:textSize="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.014"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/button_save"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/button_gray"
        android:fontFamily="@font/cascadia_mono"
        android:padding="0dp"
        android:text="@string/save_button_text"
        android:textStyle="bold"
        android:textColor="@color/term_white"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.71"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.014"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/button_correct"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:fontFamily="@font/cascadia_mono"
        android:textStyle="bold"
        android:backgroundTint="@color/correct_green"
        android:text="@string/correct_button_text"
        android:textColor="@color/term_white"
        android:textSize="25dp"
        android:padding="0dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintVertical_bias="0.93"
        app:layout_constraintStart_toEndOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_incorrect"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:fontFamily="@font/cascadia_mono"
        android:textStyle="bold"
        android:backgroundTint="@color/incorrect_red"
        android:text="@string/incorrect_button_text"
        android:textColor="@color/term_white"
        android:textSize="24dp"
        android:padding="0dp"
        android:layout_marginStart="15dp"
        app:layout_constraintVertical_bias="0.93"
        app:layout_constraintEnd_toStartOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back"
        android:layout_width="100dp"
        android:layout_height="55dp"
        app:icon="@drawable/redo_icon"
        app:iconTint="@color/term_white"
        android:backgroundTint="@color/quitting_yellow"
        android:padding="0dp"
        android:paddingStart="7dp"
        app:iconSize="32dp"
        android:contentDescription="@string/back_button_content_description"
        app:iconGravity="textStart"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintVertical_bias="0.93"
        app:layout_constraintStart_toEndOf="@id/button_incorrect"
        app:layout_constraintEnd_toStartOf="@id/button_correct"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/search_bar"
        layout="@layout/custom_search_view"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@drawable/search_background"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.09"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.danjonesapps.vocabr.CustomRecyclerView
        android:id="@+id/term_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="3dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:elevation="2dp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>