<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:backgroundTint="@color/card_gray"
    android:background="@drawable/search_result">

    <TextView
        android:id="@+id/listFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:fontFamily="@font/cascadia_mono"
        android:text="french_terms_2.csv"
        android:textColor="@color/term_white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/avgLearntScore"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/avgLearntScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="7dp"
        android:fontFamily="@font/cascadia_mono"
        android:text="learnt score: 13%"
        android:textColor="@color/term_white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/numTerms"
        app:layout_constraintTop_toBottomOf="@id/listFileName" />

    <TextView
        android:id="@+id/numTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="0dp"
        android:fontFamily="@font/cascadia_mono"
        android:text="terms: 3,489"
        android:textColor="@color/term_white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dateLastTested"
        app:layout_constraintTop_toBottomOf="@id/avgLearntScore" />

    <TextView
        android:id="@+id/dateLastTested"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/cascadia_mono"
        android:text="last tested: 13/10/2025"
        android:textColor="@color/term_white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/numTerms" />


</androidx.constraintlayout.widget.ConstraintLayout>