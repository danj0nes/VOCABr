<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:paddingBottom="10dp"
    android:backgroundTint="@color/card_gray"
    android:background="@drawable/search_result">

    <ImageView
        android:id="@+id/radio_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/radio_unchecked"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/listFileName"/>

    <TextView
        android:id="@+id/listFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="7dp"
        android:fontFamily="@font/cascadia_mono"
        android:text="french_terms_2.csv"
        android:textColor="@color/term_white"
        android:textSize="17dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/text_due"
        app:layout_constraintStart_toEndOf="@id/radio_button"
        app:layout_constraintBottom_toTopOf="@id/avgLearntScore"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_due"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:minWidth="20dp"
        android:background="@drawable/rounded_label"
        android:fontFamily="@font/cascadia_mono"
        android:gravity="center"
        android:text="1"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="0dp"
        android:textStyle="bold"
        android:textColor="@color/term_white"
        android:textSize="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.88"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/listFileName"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/avgLearntScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="7dp"
        android:fontFamily="@font/cascadia_mono"
        android:text="@string/learnt_score_default_text"
        android:textColor="@color/term_white"
        android:textSize="13dp"
        app:layout_constraintEnd_toStartOf="@id/dateLastTested"
        app:layout_constraintStart_toEndOf="@id/radio_button"
        app:layout_constraintTop_toBottomOf="@id/listFileName" />

    <TextView
        android:id="@+id/numTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="7dp"
        android:fontFamily="@font/cascadia_mono"
        android:visibility="visible"
        android:text="3,489 terms"
        android:textColor="@color/term_white"
        android:textSize="13dp"
        app:layout_constraintEnd_toStartOf="@id/dateLastTested"
        app:layout_constraintStart_toEndOf="@id/radio_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avgLearntScore" />

    <TextView
        android:id="@+id/dateLastTested"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="3dp"
        android:gravity="end|bottom"
        android:fontFamily="@font/cascadia_mono"
        android:text="13/10/2025"
        android:textColor="@color/term_white"
        android:textSize="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/avgLearntScore"
        app:layout_constraintTop_toBottomOf="@id/listFileName" />


</androidx.constraintlayout.widget.ConstraintLayout>